@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">WorkTracker</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2">@DateTime.Now.ToString("dddd d MMMM", new System.Globalization.CultureInfo("it-IT"))</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Temporary">
        <MudNavMenu>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Today" Match="NavLinkMatch.All">
                Oggi
            </MudNavLink>
            <MudNavLink Href="/calendario" Icon="@Icons.Material.Filled.CalendarMonth">
                Calendario
            </MudNavLink>
            <MudNavLink Href="/riepilogo" Icon="@Icons.Material.Filled.BarChart">
                Riepilogo
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            Secondary = "#7C3AED",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#2563EB",
            DrawerBackground = "#FFFFFF",
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
