# ============================
# WorkTracker - .gitignore
# ============================

# ---- Build output ----
bin/
obj/
out/

# ---- Visual Studio / VS Code ----
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.user
*.suo

# ---- .NET ----
*.dll
*.pdb
project.lock.json
project.fragment.lock.json
artifacts/

# ---- Database locale (dati personali reali, MAI versionare) ----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Config locali / secrets ----
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json

# ---- EF Core ----
# (le migrations SI versionano, questa riga è solo per file temporanei generati)
*.efmigrationslock

# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Logs ----
*.log
logs/

# ---- User-specific files ----
*.rsuser
*.userosscache
*.sln.docstates